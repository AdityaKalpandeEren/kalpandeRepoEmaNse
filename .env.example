# Option A (recommended): 1-year read-only Analytics Access Token
# from account.upstox.com/developer/apps -> Analytics tab -> Generate Token
UPSTOX_ACCESS_TOKEN=your_upstox_analytics_token_here

# Option B: only needed if you're using the daily-login OAuth flow instead
# (see README "Option B") - leave blank if using UPSTOX_ACCESS_TOKEN above
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=https://127.0.0.1:5000/

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
